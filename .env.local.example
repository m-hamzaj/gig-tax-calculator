# Copy this file to .env.local (gitignored, never committed) and fill in
# real values. Both are required for the AI explanation feature and rate
# limiting to work -- without them the app still runs and the calculator
# still works correctly (see lib/llm/groq-client.ts and rate-limit.ts's
# graceful-degradation behavior), but every explanation request will fail
# over to "temporarily unavailable" and rate limiting will be silently
# disabled.

# console.groq.com -> API Keys -> Create API Key.
# Free tier: ~8,000 tokens/minute shared across the whole account -- see
# the project plan for why openai/gpt-oss-20b and a low max_completion_tokens
# cap were chosen specifically to keep pressure on this budget low.
GROQ_API_KEY=

# upstash.com -> Create Database (free tier) -> REST API section.
# Used for per-IP rate limiting on /api/calculate-explain -- protects the
# GROQ_API_KEY's shared free-tier budget from being exhausted by abuse.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
