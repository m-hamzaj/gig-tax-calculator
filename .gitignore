# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except example/template files -- these have no real secrets and are
# meant to be committed so anyone cloning the repo knows which env vars
# to set (see DEPLOY.md).
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
